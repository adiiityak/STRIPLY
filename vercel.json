{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build:web",
      "outputDirectory": "dist",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    },
    "room": {
      "root": ".",
      "framework": "node",
      "entrypoint": "server/roomServiceEntry.ts",
      "devCommand": "npm run dev:room"
    }
  },
  "rewrites": [
    {
      "source": "/api/socket-io/(.*)",
      "destination": {
        "service": "room"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
